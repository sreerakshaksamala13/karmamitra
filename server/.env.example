# Copy this file to .env and adjust the values
PORT=5005
NODE_ENV=production

# Production MongoDB Atlas (M0). Format:
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/karmamitra?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/karmamitra?retryWrites=true&w=majority

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Comma separated list of allowed web origins (must include the deployed Vercel URL)
CLIENT_ORIGINS=https://karmamita.vercel.app