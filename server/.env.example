# Copy this file to .env and adjust the values
PORT=5005
NODE_ENV=development

# Local MongoDB via docker compose (npm run db:up at repo root)
MONGO_URI=mongodb://127.0.0.1:27017/karmamitra

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Comma separated list of allowed web origins (Vite dev server default)
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173